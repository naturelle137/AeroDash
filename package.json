{
  "name": "aerodash-root",
  "version": "0.3.0-alpha",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "release": "release-it",
    "prepare": "husky",
    "dev": "pnpm --filter frontend run dev",
    "build": "pnpm --filter frontend run build",
    "coverage:unit": "pnpm --filter frontend run coverage:unit",
    "test": "pnpm --filter frontend run test",
    "test:unit": "pnpm --filter frontend run test:unit",
    "test:integration": "pnpm --filter frontend run test:integration",
    "test:e2e": "pnpm --filter frontend run test:e2e",
    "test:smoke": "pnpm --filter frontend run test:smoke",
    "trace": "pnpm --filter frontend run trace",
    "trace:check": "pnpm --filter frontend run trace:check",
    "trace:check:warn": "pnpm --filter frontend run trace:check:warn",
    "trace:sync": "pnpm --filter frontend run trace:sync",
    "trace:sync:apply": "pnpm --filter frontend run trace:sync:apply",
    "lint": "pnpm --filter frontend run lint && pnpm run lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:oxlint": "pnpm --filter frontend run lint:oxlint",
    "lint:eslint": "pnpm --filter frontend run lint:eslint",
    "lint:ci:oxlint": "pnpm --filter frontend run lint:ci:oxlint",
    "lint:ci:eslint": "pnpm --filter frontend run lint:ci:eslint",
    "format": "pnpm --filter frontend run format",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.2",
    "release-it": "^20.2.0"
  },
  "pnpm": {
    "overrides": {
      "lodash": ">=4.18.0",
      "undici": ">=7.24.5 <8.0.0",
      "flatted": ">=3.4.2",
      "micromatch>picomatch": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "defu": ">=6.1.5",
      "brace-expansion@>=2.0.0 <2.0.3": "~2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": "^5.0.5",
      "yaml": ">=2.8.3",
      "smol-toml": ">=1.6.1",
      "basic-ftp": ">=5.3.1",
      "serialize-javascript": ">=7.0.3",
      "ip-address": ">=10.1.1",
      "uuid": ">=11.1.1",
      "fast-uri": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "js-cookie": ">=3.0.7",
      "qs": ">=6.15.2"
    }
  },
  "lint-staged": {
    "*.md": "pnpm run lint:md",
    "frontend/**/*.{js,ts,vue}": [
      "pnpm run lint:oxlint",
      "pnpm run lint:eslint"
    ]
  }
}
