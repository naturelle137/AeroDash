{
  "name": "@aerodash/frontend",
  "version": "0.3.0-alpha",
  "description": "AeroDash - Flight Preparation & Decision Support Tool for General Aviation",
  "private": true,
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:p1": "vitest run --config vitest.config.p1.ts",
    "test:p1:coverage": "vitest run --config vitest.config.p1.ts --coverage",
    "test:smoke": "bddgen && playwright test --grep @smoke --grep-invert @wip",
    "coverage:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.int.ts",
    "test:mutation": "stryker run",
    "test:e2e": "bddgen && playwright test --grep-invert @wip",
    "check:data-constants": "node scripts/data-constants/index.mjs",
    "comment:check": "node scripts/comment-discipline/index.mjs",
    "comment:check:all": "node scripts/comment-discipline/index.mjs --all",
    "comment:baseline": "node scripts/comment-discipline/scripts/regen-baseline.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint --fix",
    "lint:eslint": "eslint --fix --cache",
    "lint:ci:oxlint": "oxlint",
    "lint:ci:eslint": "eslint",
    "format": "prettier --write --experimental-cli src/",
    "test:theme-audit": "playwright test --config playwright.theme.config.ts",
    "test:offline": "pnpm build && playwright test --config playwright.offline.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naturelle137/AeroDash.git"
  },
  "keywords": [],
  "author": "",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/naturelle137/AeroDash/issues"
  },
  "homepage": "https://github.com/naturelle137/AeroDash#readme",
  "dependencies": {
    "pinia": "^3.0.4",
    "uuid": "^14.0.3",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "~1.65.0",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tsconfig/node24": "^24.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vitest/ui": "5.1.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "1.94.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.12.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "1.94.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "3.10.1",
    "serve": "^14.2.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1"
  }
}
