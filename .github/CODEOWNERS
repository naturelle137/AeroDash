###############################################################################
# AeroDash Governance Policy
# 
# Ownership routing only; not access control or evidence of flight readiness.
# Independent review and integration follow ADR-319.
###############################################################################

# --- GLOBAL ENGINEERING LEAD ---
# If a file does not match any specific rule, it falls back to the Lead.
# This ensures no "ownerless" code enters the develop or main branches.
*  @naturelle137

# --- FRONTEND LEAD ---
# All application source code lives in the frontend workspace.
/frontend/                              @naturelle137

# --- AVIATION PERFORMANCE & SAFETY LOGIC (P1) ---
# These files contain the core algorithms for the software
# and safety-critical logic. Independent technical review and sourced domain
# evidence are mandatory under ADR-319; no aviation certification is implied.
/frontend/src/core/                     @naturelle137

# --- DOCUMENTATION ---
# Documentation Specialist owns all general docs.
/docs/                                  @naturelle137
**/README.md                            @naturelle137

# --- ARCHITECTURE ---
# Architect owns the system design and technical blueprints.
# (Specific path overrides the general /docs/ rule above).
/docs/architecture/                     @naturelle137

# --- TESTING & QUALITY GATES ---
# These files serve the quality assurance of the software.
# The Test Lead has primary authority over these files.
.github/workflows/                      @naturelle137
.husky/                                 @naturelle137
/frontend/tests/                        @naturelle137
/frontend/**/*.spec.ts                  @naturelle137
/frontend/**/*.int.spec.ts              @naturelle137
/docs/testing/                          @naturelle137

# --- CODEOWNER STEWARDSHIP ---
# Only the Engineering Lead can modify the governance rules themselves.
.github/CODEOWNERS                      @naturelle137
