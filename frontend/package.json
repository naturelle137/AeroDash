{
  "name": "@aerodash/frontend",
  "version": "0.3.0-alpha",
  "description": "AeroDash - Flight Preparation & Decision Support Tool for General Aviation",
  "private": true,
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:p1": "vitest run --config vitest.config.p1.ts",
    "test:p1:coverage": "vitest run --config vitest.config.p1.ts --coverage",
    "test:smoke": "bddgen && playwright test --grep @smoke --grep-invert @wip",
    "coverage:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.int.ts",
    "test:e2e": "bddgen && playwright test --grep-invert @wip",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint --fix",
    "lint:eslint": "eslint --fix --cache",
    "lint:ci:oxlint": "oxlint",
    "lint:ci:eslint": "eslint",
    "format": "prettier --write --experimental-cli src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naturelle137/AeroDash.git"
  },
  "keywords": [],
  "author": "",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/naturelle137/AeroDash/issues"
  },
  "homepage": "https://github.com/naturelle137/AeroDash#readme",
  "dependencies": {
    "pinia": "^3.0.4",
    "serve": "^14.2.6",
    "uuid": "^14.0.0",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vitest/ui": "4.1.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.62.0",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-vue": "~10.9.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.62.0",
    "playwright-bdd": "^8.5.0",
    "prettier": "3.8.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7",
    "workbox-window": "^7.4.0"
  }
}
