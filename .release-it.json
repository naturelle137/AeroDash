{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore(repo): release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "pushArgs": ["--follow-tags"],
    "requireBranch": ["release/*", "hotfix/*"]
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "tokenRef": "GITHUB_TOKEN"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "types": [
          { "type": "feat", "section": "### Added" },
          { "type": "fix", "section": "### Fixed" },
          { "type": "refactor", "section": "### Changed" },
          { "type": "perf", "section": "### Changed" },
          { "type": "chore", "section": "### Engineering" },
          { "type": "docs", "section": "### Engineering" },
          { "type": "test", "section": "### Engineering" },
          { "type": "style", "section": "### Engineering" }
        ]
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n\nThe format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/),\nand this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html)."
    }
  }
}
