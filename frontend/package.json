{
  "name": "@aerodash/frontend",
  "version": "0.2.0-alpha",
  "description": "AeroDash - Flight Preparation & Decision Support Tool for General Aviation",
  "private": true,
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:p1": "vitest run --config vitest.config.p1.ts",
    "test:p1:coverage": "vitest run --config vitest.config.p1.ts --coverage",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "coverage:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.int.ts",
    "test:e2e": "bddgen && playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint --fix",
    "lint:eslint": "eslint --fix --cache",
    "lint:ci:oxlint": "oxlint",
    "lint:ci:eslint": "eslint",
    "format": "prettier --write --experimental-cli src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naturelle137/AeroDash.git"
  },
  "keywords": [],
  "author": "",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/naturelle137/AeroDash/issues"
  },
  "homepage": "https://github.com/naturelle137/AeroDash#readme",
  "dependencies": {
    "pinia": "^3.0.4",
    "serve": "^14.2.6",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/api": "^9.6.0",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vitest/ui": "4.1.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-playwright": "^2.8.0",
    "eslint-plugin-vue": "~10.8.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "playwright-bdd": "^8.4.2",
    "prettier": "3.8.1",
    "typescript": "~6.0.2",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  }
}
