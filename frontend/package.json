{
  "name": "@aerodash/frontend",
  "version": "0.3.0-alpha",
  "description": "AeroDash - Flight Preparation & Decision Support Tool for General Aviation",
  "private": true,
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:p1": "vitest run --config vitest.config.p1.ts",
    "test:p1:coverage": "vitest run --config vitest.config.p1.ts --coverage",
    "test:smoke": "bddgen && playwright test --grep @smoke --grep-invert @wip",
    "coverage:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.int.ts",
    "test:mutation": "stryker run",
    "test:e2e": "bddgen && playwright test --grep-invert @wip",
    "trace": "node scripts/trace/index.mjs",
    "trace:check": "node scripts/trace/index.mjs check",
    "trace:check:warn": "node scripts/trace/index.mjs check --warn-only",
    "trace:check:structural": "node scripts/trace/index.mjs check --structural-only --baseline",
    "trace:sync": "node scripts/trace/index.mjs sync",
    "trace:sync:apply": "node scripts/trace/index.mjs sync --apply",
    "check:data-constants": "node scripts/data-constants/index.mjs",
    "comment:check": "node scripts/comment-discipline/index.mjs",
    "comment:check:all": "node scripts/comment-discipline/index.mjs --all",
    "comment:baseline": "node scripts/comment-discipline/scripts/regen-baseline.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint --fix",
    "lint:eslint": "eslint --fix --cache",
    "lint:trace": "node scripts/trace/index.mjs check --structural-only --baseline",
    "lint:ci:oxlint": "oxlint",
    "lint:ci:eslint": "eslint",
    "format": "prettier --write --experimental-cli src/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naturelle137/AeroDash.git"
  },
  "keywords": [],
  "author": "",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/naturelle137/AeroDash/issues"
  },
  "homepage": "https://github.com/naturelle137/AeroDash#readme",
  "dependencies": {
    "pinia": "^3.0.4",
    "uuid": "^14.0.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/api": "^9.6.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "1.79.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-vue": "~10.10.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "1.79.0",
    "playwright-bdd": "^8.5.1",
    "prettier": "3.9.6",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10",
    "workbox-window": "^7.4.1"
  }
}
