{
  "name": "aerodash-root",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter frontend run dev",
    "build": "pnpm --filter frontend run build",
    "coverage:unit": "pnpm --filter frontend run coverage:unit",
    "test": "pnpm --filter frontend run test",
    "test:unit": "pnpm --filter frontend run test:unit",
    "test:integration": "pnpm --filter frontend run test:integration",
    "test:e2e": "pnpm --filter frontend run test:e2e",
    "test:smoke": "pnpm --filter frontend run test:smoke",
    "lint": "pnpm --filter frontend run lint && pnpm run lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:oxlint": "pnpm --filter frontend run lint:oxlint",
    "lint:eslint": "pnpm --filter frontend run lint:eslint",
    "lint:ci:oxlint": "pnpm --filter frontend run lint:ci:oxlint",
    "lint:ci:eslint": "pnpm --filter frontend run lint:ci:eslint",
    "format": "pnpm --filter frontend run format",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "markdownlint-cli2": "^0.21.0"
  },
  "lint-staged": {
    "*.md": "pnpm run lint:md",
    "frontend/**/*.{js,ts,vue,json,yaml,yml}": [
      "pnpm run lint:oxlint",
      "pnpm run lint:eslint"
    ]
  }
}
