{
  "name": "aerodash-root",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test": "npm run test -w frontend",
    "test:unit": "npm run test:unit -w frontend",
    "test:integration": "npm run test:integration -w frontend",
    "test:e2e": "npm run test:e2e -w frontend",
    "test:smoke": "npm run test:smoke -w frontend",
    "lint": "npm run lint -w frontend && npm run lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:oxlint": "npm run lint:oxlint -w frontend",
    "lint:eslint": "npm run lint:eslint -w frontend",
    "lint:ci:oxlint": "npm run lint:ci:oxlint -w frontend",
    "lint:ci:eslint": "npm run lint:ci:eslint -w frontend",
    "format": "npm run format -w frontend"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "markdownlint-cli2": "^0.21.0"
  },
  "lint-staged": {
    "*.md": "npm run lint:md",
    "frontend/**/*.{js,ts,vue}": "npm run lint:eslint"
  }
}
